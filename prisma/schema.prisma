generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles    UserRole[]
  createdPurchases   Purchase[] @relation("PurchaseCreatedBy")
  confirmedPurchases Purchase[] @relation("PurchaseConfirmedBy")
  receivings         Receiving[]
  purchaseReturns    PurchaseReturn[]
  sales           Sale[]
  saleReturns     SaleReturn[]
  startedStockOpnames  StockOpname[]   @relation("StockOpnameStartedBy")
  reviewedStockOpnames StockOpname[]   @relation("StockOpnameReviewedBy")
  stockMovements       StockMovement[]
  createdExpenses      Expense[]       @relation("ExpenseCreatedBy")
  approvedExpenses     Expense[]       @relation("ExpenseApprovedBy")
  auditLogs            AuditLog[]

  @@map("users")
}

model Role {
  id   BigInt @id @default(autoincrement())
  name String @unique // OWNER, KASIR, GUDANG, FINANCE

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Location {
  id       BigInt  @id @default(autoincrement())
  name     String
  type     String  // STORE, WAREHOUSE
  isActive Boolean @default(true) @map("is_active")

  inventories Inventory[]
  purchases Purchase[]
  sales Sale[]
  stockOpnames   StockOpname[]
  stockMovements StockMovement[]

  @@map("locations")
}

model Category {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
}

model Supplier {
  id          BigInt   @id @default(autoincrement())
  name        String
  contactInfo String?  @map("contact_info")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@map("suppliers")
}

model Product {
  id            BigInt   @id @default(autoincrement())
  sku           String   @unique
  name          String
  categoryId    BigInt   @map("category_id")
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(12, 2)
  minimumStock  Int      @default(0) @map("minimum_stock")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category      Category    @relation(fields: [categoryId], references: [id])
  inventories   Inventory[]
  purchaseItems PurchaseItem[]
  saleItems SaleItem[]
  stockOpnameItems StockOpnameItem[]
  stockMovements   StockMovement[]

  @@map("products")
}

model Inventory {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt   @map("product_id")
  locationId   BigInt   @map("location_id")
  currentStock Int      @default(0) @map("current_stock")
  averageCost  Decimal  @default(0) @map("average_cost") @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product  @relation(fields: [productId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("inventories")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

model Purchase {
  id             BigInt         @id @default(autoincrement())
  purchaseNumber String         @unique @map("purchase_number")
  supplierId     BigInt         @map("supplier_id")
  locationId     BigInt         @map("location_id")
  createdBy      BigInt         @map("created_by")
  confirmedBy    BigInt?        @map("confirmed_by")
  status         PurchaseStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at")
  confirmedAt    DateTime?      @map("confirmed_at")
  cancelledAt    DateTime?      @map("cancelled_at")

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])
  creator   User     @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])
  confirmer User?    @relation("PurchaseConfirmedBy", fields: [confirmedBy], references: [id])

  items      PurchaseItem[]
  receivings Receiving[]
  returns    PurchaseReturn[]

  @@map("purchases")
}

model PurchaseItem {
  id                BigInt  @id @default(autoincrement())
  purchaseId        BigInt  @map("purchase_id")
  productId         BigInt  @map("product_id")
  quantityOrdered   Int     @map("quantity_ordered")
  unitPurchasePrice Decimal @map("unit_purchase_price") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  receivingItems ReceivingItem[]

  @@map("purchase_items")
}

model Receiving {
  id              BigInt   @id @default(autoincrement())
  receivingNumber String   @unique @map("receiving_number")
  purchaseId      BigInt   @map("purchase_id")
  receivedBy      BigInt   @map("received_by")
  receivedAt      DateTime @map("received_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  receiver User     @relation(fields: [receivedBy], references: [id])

  items ReceivingItem[]

  @@map("receivings")
}

model ReceivingItem {
  id                      BigInt  @id @default(autoincrement())
  receivingId             BigInt  @map("receiving_id")
  purchaseItemId          BigInt  @map("purchase_item_id")
  quantityReceived        Int     @map("quantity_received")
  unitPurchasePriceActual Decimal @map("unit_purchase_price_actual") @db.Decimal(12, 2)

  receiving    Receiving    @relation(fields: [receivingId], references: [id])
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])

  purchaseReturnItems PurchaseReturnItem[]

  @@map("receiving_items")
}

model PurchaseReturn {
  id           BigInt   @id @default(autoincrement())
  returnNumber String   @unique @map("return_number")
  purchaseId   BigInt   @map("purchase_id")
  supplierId   BigInt   @map("supplier_id")
  createdBy    BigInt   @map("created_by")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  items PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               BigInt @id @default(autoincrement())
  purchaseReturnId BigInt @map("purchase_return_id")
  receivingItemId  BigInt @map("receiving_item_id")
  quantityReturned Int    @map("quantity_returned")

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  receivingItem  ReceivingItem  @relation(fields: [receivingItemId], references: [id])

  @@map("purchase_return_items")
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@map("customers")
}

model Sale {
  id                 BigInt     @id @default(autoincrement())
  transactionNumber  String     @unique @map("transaction_number")
  locationId         BigInt     @map("location_id")
  cashierId          BigInt     @map("cashier_id")
  customerId         BigInt?    @map("customer_id")
  status             SaleStatus @default(PENDING)
  subtotal           Decimal    @db.Decimal(12, 2)
  discountAmount     Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRateSnapshot    Decimal    @default(0) @map("tax_rate_snapshot") @db.Decimal(5, 4)
  taxAmount          Decimal    @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total              Decimal    @db.Decimal(12, 2)
  createdAt          DateTime   @default(now()) @map("created_at")
  completedAt        DateTime?  @map("completed_at")
  cancelledAt        DateTime?  @map("cancelled_at")

  location Location  @relation(fields: [locationId], references: [id])
  cashier  User      @relation(fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  items           SaleItem[]
  returns         SaleReturn[]
  paymentAttempts PaymentAttempt[]

  @@map("sales")
}

model SaleItem {
  id                        BigInt  @id @default(autoincrement())
  saleId                    BigInt  @map("sale_id")
  productId                 BigInt  @map("product_id")
  productNameSnapshot       String  @map("product_name_snapshot")
  quantity                  Int
  unitSellingPriceSnapshot  Decimal @map("unit_selling_price_snapshot") @db.Decimal(12, 2)
  discountAmount            Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  unitCostSnapshot          Decimal @map("unit_cost_snapshot") @db.Decimal(12, 2)
  subtotal                  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  saleReturnItems SaleReturnItem[]

  @@map("sale_items")
}

model SaleReturn {
  id           BigInt   @id @default(autoincrement())
  returnNumber String   @unique @map("return_number")
  saleId       BigInt   @map("sale_id")
  processedBy  BigInt   @map("processed_by")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  sale      Sale @relation(fields: [saleId], references: [id])
  processor User @relation(fields: [processedBy], references: [id])

  items SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id               BigInt          @id @default(autoincrement())
  saleReturnId     BigInt          @map("sale_return_id")
  saleItemId       BigInt          @map("sale_item_id")
  quantityReturned Int             @map("quantity_returned")
  condition        ReturnCondition
  refundAmount     Decimal         @map("refund_amount") @db.Decimal(12, 2)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@map("sale_return_items")
}

model PaymentAttempt {
  id             BigInt        @id @default(autoincrement())
  saleId         BigInt        @map("sale_id")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amountReceived Decimal       @map("amount_received") @db.Decimal(12, 2)
  amountApplied  Decimal       @map("amount_applied") @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  referenceCode  String?       @map("reference_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("payment_attempts")
}

enum StockOpnameStatus {
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_RECOUNT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum StockMovementSourceType {
  RECEIVING
  SALE
  OPNAME_ADJUSTMENT
  SALE_RETURN
  PURCHASE_RETURN
}

model StockOpname {
  id           BigInt            @id @default(autoincrement())
  opnameNumber String            @unique @map("opname_number")
  locationId   BigInt            @map("location_id")
  startedBy    BigInt            @map("started_by")
  reviewedBy   BigInt?           @map("reviewed_by")
  status       StockOpnameStatus @default(SUBMITTED)
  startedAt    DateTime          @map("started_at")
  submittedAt  DateTime?         @map("submitted_at")
  reviewedAt   DateTime?         @map("reviewed_at")
  rejectReason String?           @map("reject_reason")

  location Location @relation(fields: [locationId], references: [id])
  starter  User     @relation("StockOpnameStartedBy", fields: [startedBy], references: [id])
  reviewer User?    @relation("StockOpnameReviewedBy", fields: [reviewedBy], references: [id])

  items StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id                     BigInt  @id @default(autoincrement())
  stockOpnameId          BigInt  @map("stock_opname_id")
  productId              BigInt  @map("product_id")
  systemQtySnapshot      Int     @map("system_qty_snapshot")
  physicalQty            Int     @map("physical_qty")
  difference             Int
  systemQtyAtAdjustment  Int?    @map("system_qty_at_adjustment")
  adjustmentDelta        Int?    @map("adjustment_delta")
  reason                 String?

  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("stock_opname_items")
}

model StockMovement {
  id             BigInt                   @id @default(autoincrement())
  productId      BigInt                   @map("product_id")
  locationId     BigInt                   @map("location_id")
  userId         BigInt?                  @map("user_id")
  sourceType     StockMovementSourceType  @map("source_type")
  sourceId       BigInt                   @map("source_id")
  quantityDelta  Int                      @map("quantity_delta")
  beforeQty      Int                      @map("before_qty")
  afterQty       Int                      @map("after_qty")
  createdAt      DateTime                 @default(now()) @map("created_at")

  product  Product   @relation(fields: [productId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([sourceType, sourceId])
  @@index([productId, locationId, createdAt])
  @@map("stock_movements")
}

model ExpenseCategory {
  id   BigInt @id @default(autoincrement())
  name String @unique

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                 BigInt        @id @default(autoincrement())
  expenseCategoryId  BigInt        @map("expense_category_id")
  createdBy          BigInt        @map("created_by")
  approvedBy         BigInt?       @map("approved_by")
  status             ExpenseStatus @default(DRAFT)
  amount             Decimal       @db.Decimal(12, 2)
  expenseDate        DateTime      @map("expense_date") @db.Date
  description        String?
  createdAt          DateTime      @default(now()) @map("created_at")

  category ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  creator  User            @relation("ExpenseCreatedBy", fields: [createdBy], references: [id])
  approver User?           @relation("ExpenseApprovedBy", fields: [approvedBy], references: [id])

  @@map("expenses")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   BigInt   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}